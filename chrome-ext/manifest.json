{
  "manifest_version": 3,
  "name": "PPAC Tracker",
  "short_name": "PPAC Tracker",
  "description": "Track Microsoft Power Platform and Microsoft 365 release updates in a Chrome side panel.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://releaseplans.microsoft.com/*",
    "https://www.microsoft.com/*"
  ],
  "action": {
    "default_title": "Open PPAC Tracker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
