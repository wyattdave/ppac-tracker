        {
            "id": 566997,
            "title": "Microsoft Copilot Studio: Block the use of maker-provided credentials for authentication",
            "description": "By blocking the use of maker\u0027s credentials by AI agents, admins can increase the security and compliance of agents in their organizations:\n- Prevent unauthorized access to sensitive systems or data that the maker\u0027s credentials might have access to.\n- Help organizations comply with data protection regulations (such as GDPR or HIPAA) by ensuring only authorized identities are used for data access.\n- Enable IT and security teams to enforce organizational policies around identity and access management.\n- Increase trust among stakeholders and IT departments, making it easier to adopt AI agents at scale.",
            "cloudInstances": [
                "Worldwide (Standard Multi-Tenant)"
            ],
